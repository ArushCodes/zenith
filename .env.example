# Server-only. Never use VITE_ for a privileged key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Public browser connection settings, from the SAME Supabase project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Optional mail recovery delivery
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
EMAIL_FROM=

CRON_SECRET=
EMAIL_INTAKE_SECRET=
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
